# Copy to .env and fill in real values.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE__URL=postgres://postgres:postgres@localhost:5432/fulcrum
DATABASE__MAX_CONNECTIONS=20
DATABASE__MIN_CONNECTIONS=2

# ── Chain ─────────────────────────────────────────────────────────────────────
CHAIN__RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
CHAIN__WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
CHAIN__CHAIN_ID=1
CHAIN__GUARDIAN_URL=http://localhost:3000
CHAIN__MORPHO_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFc
CHAIN__TX_TIMEOUT_SECS=120
CHAIN__MAX_GAS_GWEI=200

# ── Engine ────────────────────────────────────────────────────────────────────
ENGINE__POLL_INTERVAL_SECS=30
ENGINE__MAX_STEP_RETRIES=5
ENGINE__RETRY_BASE_MS=500
ENGINE__HEALTH_THRESHOLDS__REBALANCE_BELOW=1.15
ENGINE__HEALTH_THRESHOLDS__CLOSE_BELOW=1.05

# ── API ───────────────────────────────────────────────────────────────────────
API__HOST=0.0.0.0
API__PORT=8080
# Generate with: openssl rand -hex 32
API__API_KEY=changeme
